{
  "name": "@janus/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "x402:live": "node hedera/scripts/exact-live.mjs",
    "x402:test": "node --test hedera/test/exact-payment.test.mjs",
    "test": "node --test hedera/test/*.test.mjs workbench/*.test.mjs arkiv/*.test.mjs",
    "test:workbench": "node --test workbench/*.test.mjs",
    "hedera:init": "node hedera/scripts/init.mjs",
    "hedera:preflight": "node hedera/scripts/preflight.mjs",
    "hedera:status": "node hedera/scripts/status.mjs",
    "hedera:prepare": "node hedera/scripts/prepare.mjs",
    "hedera:deploy": "node hedera/scripts/deploy.mjs",
    "hedera:fund": "node hedera/scripts/fund.mjs",
    "hedera:fund-gas": "node hedera/scripts/fund-gas.mjs",
    "hedera:serve": "node hedera/scripts/server.mjs",
    "hedera:buy": "node hedera/scripts/buy.mjs",
    "hedera:recover": "node hedera/scripts/recover.mjs",
    "hedera:verify-live": "node hedera/scripts/verify-live.mjs",
    "hedera:final-check": "node hedera/scripts/final-check.mjs",
    "task:serve": "node hedera/scripts/task-server.mjs",
    "demo:handoff": "node runner/demo.mjs",
    "task:preflight": "node hedera/scripts/task-preflight.mjs",
    "task:live": "node hedera/scripts/task-live.mjs",
    "arkiv:query": "node --env-file-if-exists=.env.arkiv arkiv/cli.mjs query",
    "arkiv:preflight": "node --env-file-if-exists=.env.arkiv arkiv/cli.mjs preflight",
    "arkiv:publish": "node --env-file-if-exists=.env.arkiv arkiv/cli.mjs publish",
    "demo:arkiv": "node --env-file-if-exists=.env.arkiv arkiv/live-demo.mjs",
    "demo:paid-research": "node --test hedera/test/paid-research.test.mjs",
    "demo:paid-research:live": "node --env-file=.env.providers --test hedera/test/paid-research.test.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hiero-ledger/sdk": "2.90.1",
    "@x402/core": "2.30.0",
    "@x402/hedera": "2.30.0",
    "pg": "8.23.1",
    "viem": "2.57.16"
  }
}
